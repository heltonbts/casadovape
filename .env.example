# Neon — conexão direta, sem pooler (usada pelo Prisma Migrate para rodar DDL)
DIRECT_URL=""

# Segredo para assinar a sessão do admin (troque em produção)
AUTH_SECRET=""

# Credenciais do admin criadas pelo seed
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Vercel Blob — armazenamento das fotos enviadas no admin
# (Vercel > Storage > Blob > .env.local, ou `vercel env pull`)
BLOB_READ_WRITE_TOKEN=""
