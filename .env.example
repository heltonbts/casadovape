# Neon — conexão com pooler (usada pela aplicação em runtime)
DATABASE_URL=""

# Neon — conexão direta, sem pooler (usada pelo Prisma Migrate para rodar DDL)
DIRECT_URL=""

# Segredo para assinar a sessão do admin (troque em produção)
AUTH_SECRET=""

# Credenciais do admin criadas pelo seed
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Vercel Blob — armazenamento das fotos enviadas no admin.
# Basta UM dos dois caminhos:
#  1) token de leitura/escrita (Vercel > Storage > Blob > aba .env.local).
#     É o único que funciona em dev local.
#  2) id do store + VERCEL_OIDC_TOKEN, que a Vercel injeta sozinha no deploy.
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""
